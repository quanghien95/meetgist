# Copy to .env and fill in your Google AI Studio API key.
GEMINI_API_KEY=
# Optional Gemini override. Default: gemini-flash-latest (moving alias).
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-pro-latest

# Where recordings + transcripts are written. Defaults to ~/Documents/meetgist.
# Set an absolute path to send them elsewhere (e.g. a Dropbox/iCloud folder so
# they sync across devices). No quotes needed; spaces and non-ASCII are fine.
# MEETGIST_OUTPUT_DIR=/Users/you/Documents/meetgist

# Optional: enable OpenAI transcription.
# TRANSCRIPT_PROVIDER=auto     # auto, gemini, or openai
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSCRIBE_FALLBACK_MODEL=gpt-4o-transcribe
# OPENAI_SINGLE_SPEAKER_LABEL=Me
# OPENAI_TRANSCRIBE_PROMPT=Meeting or voice-note recording. Preserve the original language exactly, including Chinese-English code-switching. Add natural punctuation. Do not summarize, translate, or omit spoken content.
# OPENAI_CHUNK_SECONDS=600
# OPENAI_CHUNK_BITRATE=32k
# OPENAI_MIN_MEAN_VOLUME_DB=-70
# GEMINI_AUDIO_REQUEST_MAX_MB=20
# OPENAI_FILE_THRESHOLD_RATIO=0.8
# GEMINI_CHUNK_SECONDS=600
# GEMINI_CHUNK_MIN_DURATION_SECONDS=1800
