# Build artifacts
.build/

# Python environment & secrets
scripts/.venv/
scripts/.env
# `scripts/.env` alone does NOT cover backups: a timestamped copy holding live API
# keys showed up untracked on 2026-07-29. Ignore every .env variant EXCEPT the
# committed template — hence the negation, which must stay after the wildcards.
.env
.env.*
.env.bak*
!scripts/.env.example
!.env.example

# Local run logs
logs/

# macOS / Python cruft
.DS_Store
__pycache__/
*.pyc

# Local audio + transcripts never belong in the repo
*.m4a
*.mp3
*.wav
*.mp4

# Internal cold-start handoff doc (personal paths) — keep local, do not publish
HANDOFF.md

# commercialization / marketing notes are kept private, not in the public repo
business/

# Generated by XcodeGen (source of truth is app/project.yml)
app/*.xcodeproj

# Xcode user state from opening Package.swift
.swiftpm/
*.xcuserstate
